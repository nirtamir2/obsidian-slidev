{
  "name": "obsidian-slidev",
  "type": "module",
  "version": "0.0.18",
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39",
  "description": "Create Markdown-based presentations in Obsidian using Slidev.",
  "author": "Nir Tamir <nirtamir2@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirtamir2/obsidian-slidev"
  },
  "keywords": [],
  "main": "main.js",
  "scripts": {
    "build": "vite build",
    "ci": "pnpm run lint && pnpm run format:check && pnpm run type-check && pnpm test && pnpm build && pnpm run verify:build",
    "dev": "vite build -w -m development",
    "format": "prettier \"**/*\" --write --ignore-unknown",
    "format:check": "prettier \"**/*\" --check --ignore-unknown",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx,json}\"",
    "lint:fix": "eslint --fix \"**/*.{ts,tsx,js,jsx,json}\"",
    "test": "vitest run",
    "test:launcher": "vitest run src/launcher/slidevLauncher.test.ts",
    "type-check": "tsc --pretty --noEmit",
    "verify:build": "node scripts/verify-build.mjs",
    "version": "node version-bump.mjs"
  },
  "dependencies": {
    "solid-js": "^1.9.14",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^4.2.3",
    "@nirtamir2/eslint-config": "^0.2.7",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^24.3.0",
    "eslint": "^10.7.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.4.2",
    "eslint-plugin-solid": "^0.14.5",
    "obsidian": "^1.8.7",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^2.5.22",
    "tslib": "2.8.1",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.12",
    "vite-plugin-static-copy": "^3.1.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/utils": "^8.63.0"
    }
  }
}
